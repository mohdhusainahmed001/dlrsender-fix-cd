pipeline {
    agent { label 'erlang-agent' }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Target environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Tag already pushed by the CI pipeline, e.g. release-45 or main-102'
        )

        booleanParam(
            name: 'ROLLBACK_ENABLED',
            defaultValue: true,
            description: 'Automatically roll back to the previous known-good version if health checks fail'
        )
    }

    environment {
        // Jenkins container -> Nexus container
        // Used by the Verify Image Exists stage
        REGISTRY_URL = 'nexus:8082'

        // Host Docker daemon -> Nexus
        // Used by Ansible during docker login/pull
        NEXUS_HOST_REGISTRY = 'localhost:8082'

        REPO_PATH = "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"

        // Image address used inside Jenkins
        DLRSENDER_IMAGE = "${REGISTRY_URL}/${REPO_PATH}:${params.IMAGE_TAG.trim()}"

        ANSIBLE_DIR = 'ansible'
        INVENTORY_FILE = "${ANSIBLE_DIR}/inventory/${params.ENVIRONMENT}.ini"
        PLAYBOOK = "${ANSIBLE_DIR}/deploy.yml"

        NEXUS_CREDS_ID = 'nexus-creds'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error(
                            "IMAGE_TAG is required, e.g. the tag your CI pipeline just pushed to " +
                            "${env.REGISTRY_URL}/${env.REPO_PATH}"
                        )
                    }

                    if (!(params.IMAGE_TAG.trim() ==~ /^[a-zA-Z0-9_.\-]+$/)) {
                        error("IMAGE_TAG contains invalid characters: '${params.IMAGE_TAG}'")
                    }

                    echo "Deploying ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Inventory') {
            steps {
                sh """
                    test -f ${INVENTORY_FILE} || (
                        echo 'Inventory file missing: ${INVENTORY_FILE}'
                        exit 1
                    )

                    ansible-inventory -i ${INVENTORY_FILE} --list > /dev/null
                """
            }
        }

        stage('Approval') {
            when {
                expression {
                    params.ENVIRONMENT in ['uat', 'prod']
                }
            }

            steps {
                input message: "Deploy ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}?"
            }
        }

        stage('Verify Image Exists in Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        HTTP_STATUS=\\$(curl -s \
                            -o /tmp/nexus_check_response.json \
                            -w "%{http_code}" \
                            -u "\\$NEXUS_USER:\\$NEXUS_PASS" \
                            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                            "http://${REGISTRY_URL}/v2/${REPO_PATH}/manifests/${params.IMAGE_TAG.trim()}")

                        echo "Nexus responded with HTTP \\$HTTP_STATUS"

                        cat /tmp/nexus_check_response.json

                        if [ "\\$HTTP_STATUS" != "200" ]; then
                            echo "Image ${DLRSENDER_IMAGE} not found in Nexus (HTTP \\$HTTP_STATUS)"
                            exit 1
                        fi

                        echo "Image ${DLRSENDER_IMAGE} exists in Nexus."
                    '''
                }
            }
        }

        stage('Deploy via Ansible') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh """
                        ansible-playbook -i ${INVENTORY_FILE} ${PLAYBOOK} \\
                            --extra-vars "dlrsender_image=${NEXUS_HOST_REGISTRY}/${REPO_PATH}:${params.IMAGE_TAG.trim()} \\
                                          dlrsender_registry=${NEXUS_HOST_REGISTRY} \\
                                          dlrsender_registry_user=\\$NEXUS_USER \\
                                          dlrsender_registry_pass=\\$NEXUS_PASS \\
                                          target_environment=${params.ENVIRONMENT} \\
                                          rollback_enabled=${params.ROLLBACK_ENABLED}"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployed ${DLRSENDER_IMAGE} to ${params.ENVIRONMENT} successfully. All instances passed health checks."
        }

        failure {
            echo "Deployment FAILED for ${DLRSENDER_IMAGE} on ${params.ENVIRONMENT}."
            echo "If ROLLBACK_ENABLED was true, check the 'Deploy via Ansible' log - Ansible attempts rollback automatically and reports the restored version and its health check result there."
        }
    }
}