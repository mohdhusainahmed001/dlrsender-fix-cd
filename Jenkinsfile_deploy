pipeline {

    agent {
        label 'erlang-agent'
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Target deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag already pushed to Nexus, e.g. omni_v2-48'
        )

        booleanParam(
            name: 'ROLLBACK_ENABLED',
            defaultValue: true,
            description: 'Automatically rollback to the previous known-good image if deployment or health checks fail'
        )
    }

    environment {

        // Jenkins container -> Nexus container
        REGISTRY_URL = 'nexus:8082'

        // Docker host / Ansible target -> Nexus
        NEXUS_HOST_REGISTRY = 'localhost:8082'

        // Ansible
        ANSIBLE_DIR = 'ansible'
        PLAYBOOK = 'ansible/deploy.yml'

        // Jenkins credential
        NEXUS_CREDS_ID = 'nexus-creds'
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '30'
            )
        )
    }

    stages {

        /*
         * =========================================================
         * 1. Validate parameters
         * =========================================================
         */

        stage('Validate Parameters') {

            steps {

                script {

                    def imageTag = params.IMAGE_TAG?.trim()

                    if (!imageTag) {
                        error(
                            'IMAGE_TAG is required. Example: omni_v2-48'
                        )
                    }

                    if (!(imageTag ==~ /^[a-zA-Z0-9_.-]+$/)) {
                        error(
                            "IMAGE_TAG contains invalid characters: '${imageTag}'"
                        )
                    }

                    env.IMAGE_TAG_CLEAN = imageTag

                    env.REPO_PATH =
                        "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"

                    env.DLRSENDER_IMAGE =
                        "${env.NEXUS_HOST_REGISTRY}/${env.REPO_PATH}:${imageTag}"

                    env.DLRSENDER_JENKINS_IMAGE =
                        "${env.REGISTRY_URL}/${env.REPO_PATH}:${imageTag}"

                    env.INVENTORY_FILE =
                        "${env.ANSIBLE_DIR}/inventory/${params.ENVIRONMENT}.ini"

                    echo '=========================================='
                    echo 'DLR Sender Deployment Parameters'
                    echo '=========================================='
                    echo "Environment       : ${params.ENVIRONMENT}"
                    echo "Image Tag         : ${imageTag}"
                    echo "Repository        : ${env.REPO_PATH}"
                    echo "Host Image        : ${env.DLRSENDER_IMAGE}"
                    echo "Jenkins Image     : ${env.DLRSENDER_JENKINS_IMAGE}"
                    echo "Inventory         : ${env.INVENTORY_FILE}"
                    echo "Rollback Enabled  : ${params.ROLLBACK_ENABLED}"
                    echo '=========================================='
                }
            }
        }

        /*
         * =========================================================
         * 2. Checkout
         * =========================================================
         */

        stage('Checkout') {

            steps {

                checkout scm

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Repository Checkout"
                    echo "=========================================="

                    echo "Working directory:"
                    pwd

                    echo
                    echo "Repository files:"
                    ls -la

                    echo
                    echo "Ansible files:"
                    find ansible -maxdepth 5 -type f | sort
                '''
            }
        }

        /*
         * =========================================================
         * 3. Validate Ansible configuration
         * =========================================================
         */

        stage('Validate Ansible Configuration') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Configuration"
                    echo "=========================================="

                    test -f "${INVENTORY_FILE}" || {
                        echo "ERROR: Inventory file not found:"
                        echo "${INVENTORY_FILE}"
                        exit 1
                    }

                    test -f "${PLAYBOOK}" || {
                        echo "ERROR: Playbook not found:"
                        echo "${PLAYBOOK}"
                        exit 1
                    }

                    test -f "ansible/roles/dlrsender/tasks/main.yml"
                    test -f "ansible/roles/dlrsender/tasks/deploy_standalone.yml"
                    test -f "ansible/roles/dlrsender/tasks/healthcheck.yml"
                    test -f "ansible/roles/dlrsender/tasks/rollback.yml"

                    echo "Required files are present."

                    echo
                    echo "Validating inventory..."

                    ansible-inventory \
                        -i "${INVENTORY_FILE}" \
                        --list > /dev/null

                    echo "Inventory validation successful."
                '''
            }
        }

        /*
         * =========================================================
         * 4. Ansible syntax check
         * =========================================================
         */

        stage('Ansible Syntax Check') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Ansible Syntax Check"
                    echo "=========================================="

                    ansible-playbook \
                        -i "${INVENTORY_FILE}" \
                        "${PLAYBOOK}" \
                        --syntax-check

                    echo "Ansible syntax check successful."
                '''
            }
        }

        /*
         * =========================================================
         * 5. Check Jenkins -> Nexus
         * =========================================================
         */

        stage('Check Nexus Connectivity') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Jenkins -> Nexus Connectivity"
                    echo "=========================================="

                    HTTP_STATUS=$(curl -s \
                        -o /tmp/nexus_root_response \
                        -w "%{http_code}" \
                        "http://${REGISTRY_URL}/v2/")

                    echo "Nexus HTTP status: ${HTTP_STATUS}"

                    # 401 is expected because Docker Registry requires authentication.
                    if [ "${HTTP_STATUS}" != "401" ] && [ "${HTTP_STATUS}" != "200" ]; then

                        echo "ERROR: Jenkins cannot reach Nexus."

                        if [ -f /tmp/nexus_root_response ]; then
                            cat /tmp/nexus_root_response
                        fi

                        exit 1
                    fi

                    echo "SUCCESS: Jenkins can reach Nexus."
                '''
            }
        }

        /*
         * =========================================================
         * 6. Approval for UAT / PROD
         * =========================================================
         */

        stage('Approval') {

            when {

                expression {
                    params.ENVIRONMENT in ['uat', 'prod']
                }
            }

            steps {

                input(
                    message: "Deploy ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}?",
                    ok: 'Deploy'
                )
            }
        }

        /*
         * =========================================================
         * 7. Verify Docker image exists in Nexus
         * =========================================================
         */

        stage('Verify Image Exists in Nexus') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Checking DLR Sender Image in Nexus"
                        echo "=========================================="

                        echo "Repository : ${REPO_PATH}"
                        echo "Image Tag  : ${IMAGE_TAG_CLEAN}"
                        echo "Image      : ${DLRSENDER_JENKINS_IMAGE}"

                        HTTP_STATUS=$(curl -s \
                            -o /tmp/nexus_manifest.json \
                            -w "%{http_code}" \
                            -u "${NEXUS_USER}:${NEXUS_PASS}" \
                            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                            "http://${REGISTRY_URL}/v2/${REPO_PATH}/manifests/${IMAGE_TAG_CLEAN}")

                        echo
                        echo "Nexus HTTP status: ${HTTP_STATUS}"

                        if [ "${HTTP_STATUS}" != "200" ]; then

                            echo
                            echo "ERROR: Docker image does not exist in Nexus."
                            echo "Repository : ${REPO_PATH}"
                            echo "Tag        : ${IMAGE_TAG_CLEAN}"
                            echo "HTTP       : ${HTTP_STATUS}"

                            if [ -s /tmp/nexus_manifest.json ]; then
                                echo
                                echo "Nexus response:"
                                cat /tmp/nexus_manifest.json
                            fi

                            exit 1
                        fi

                        echo
                        echo "SUCCESS: Docker image exists in Nexus."
                        echo "Image: ${DLRSENDER_JENKINS_IMAGE}"
                    '''
                }
            }
        }

        /*
         * =========================================================
         * 8. Validate Docker access
         * =========================================================
         */

        stage('Validate Docker Access') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Docker Access"
                    echo "=========================================="

                    docker version

                    echo
                    echo "Docker containers:"

                    docker ps \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}' \
                        | head -30

                    echo
                    echo "Docker access successful."
                '''
            }
        }

        /*
         * =========================================================
         * 9. Validate Ansible Docker access
         * =========================================================
         */

        stage('Validate Ansible Docker Access') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Docker Access"
                    echo "=========================================="

                    echo "Testing Ansible connectivity..."

                    ansible \
                        -i "${INVENTORY_FILE}" \
                        all \
                        -m ping

                    echo
                    echo "Testing community.docker collection..."

                    ansible \
                        -i "${INVENTORY_FILE}" \
                        all \
                        -m community.docker.docker_info

                    echo
                    echo "Ansible Docker access successful."
                '''
            }
        }

        /*
         * =========================================================
         * 10. Deploy using Ansible
         * =========================================================
         */

        stage('Deploy via Ansible') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Starting DLR Sender Deployment"
                        echo "=========================================="

                        echo "Environment : ${ENVIRONMENT}"
                        echo "Image       : ${DLRSENDER_IMAGE}"
                        echo "Inventory   : ${INVENTORY_FILE}"
                        echo "Playbook    : ${PLAYBOOK}"
                        echo "Rollback    : ${ROLLBACK_ENABLED}"

                        echo "=========================================="

                        echo
                        echo "Checking sudo access..."

                        if ! sudo -n true 2>/dev/null; then

                            echo
                            echo "ERROR: Jenkins agent does not have passwordless sudo."
                            echo
                            echo "Your Ansible playbook uses become: true."
                            echo "Configure the Jenkins agent user with NOPASSWD sudo."
                            echo

                            exit 1
                        fi

                        echo "Passwordless sudo check successful."

                        echo
                        echo "Running Ansible deployment..."

                        ansible-playbook \
                            -i "${INVENTORY_FILE}" \
                            "${PLAYBOOK}" \
                            --extra-vars "dlrsender_image=${DLRSENDER_IMAGE}" \
                            --extra-vars "dlrsender_registry=${NEXUS_HOST_REGISTRY}" \
                            --extra-vars "dlrsender_registry_user=${NEXUS_USER}" \
                            --extra-vars "dlrsender_registry_pass=${NEXUS_PASS}" \
                            --extra-vars "target_environment=${ENVIRONMENT}" \
                            --extra-vars "rollback_enabled=${ROLLBACK_ENABLED}"

                        echo
                        echo "Ansible deployment completed successfully."
                    '''
                }
            }
        }

        /*
         * =========================================================
         * 11. Verify deployment
         * =========================================================
         */

        stage('Verify Deployment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Post Deployment Verification"
                    echo "=========================================="

                    echo
                    echo "DLR Sender containers:"

                    docker ps \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}' \
                        | grep -E 'dlrsender' || {

                            echo "ERROR: No DLR Sender containers found."

                            exit 1
                        }

                    echo
                    echo "Checking DLR Sender health endpoints..."

                    for PORT in 15001 15002
                    do

                        echo
                        echo "Checking http://127.0.0.1:${PORT}/metrics"

                        HTTP_STATUS=$(curl -s \
                            -o /tmp/dlrsender_${PORT}_metrics \
                            -w "%{http_code}" \
                            "http://127.0.0.1:${PORT}/metrics")

                        echo "HTTP status: ${HTTP_STATUS}"

                        if [ "${HTTP_STATUS}" != "200" ]; then

                            echo "ERROR: DLR Sender health check failed on port ${PORT}"

                            if [ -s "/tmp/dlrsender_${PORT}_metrics" ]; then
                                cat "/tmp/dlrsender_${PORT}_metrics"
                            fi

                            exit 1
                        fi

                        echo "Port ${PORT}: HEALTHY"

                    done

                    echo
                    echo "Deployment verification successful."
                '''
            }
        }
    }

    /*
     * =============================================================
     * POST ACTIONS
     * =============================================================
     */

    post {

        success {

            echo '=========================================='
            echo 'DLR SENDER DEPLOYMENT SUCCESSFUL'
            echo '=========================================='

            echo "Environment      : ${params.ENVIRONMENT}"
            echo "Image Tag        : ${params.IMAGE_TAG}"
            echo "Repository       : ${env.REPO_PATH}"
            echo "Docker Image     : ${env.DLRSENDER_IMAGE}"
            echo "Rollback Enabled : ${params.ROLLBACK_ENABLED}"

            echo 'All configured DLR Sender instances passed deployment and health checks.'
        }

        failure {

            echo '=========================================='
            echo 'DLR SENDER DEPLOYMENT FAILED'
            echo '=========================================='

            echo "Environment : ${params.ENVIRONMENT}"
            echo "Image Tag   : ${params.IMAGE_TAG}"
            echo "Repository  : ${env.REPO_PATH}"

            echo 'If rollback was enabled, check the Ansible deployment logs.'
            echo 'Ansible will attempt to restore the previous known-good image.'
        }

        always {

            sh '''
                rm -f /tmp/nexus_manifest.json || true
                rm -f /tmp/nexus_root_response || true
                rm -f /tmp/dlrsender_15001_metrics || true
                rm -f /tmp/dlrsender_15002_metrics || true
            '''
        }
    }
}