pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Target deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag already pushed to Nexus, e.g. omni_v2-48'
        )

        booleanParam(
            name: 'ROLLBACK_ENABLED',
            defaultValue: false,
            description: 'Enable automatic rollback if deployment/health check fails'
        )

        booleanParam(
            name: 'REQUIRE_APPROVAL',
            defaultValue: false,
            description: 'Require manual approval before deployment'
        )
    }

    environment {

        NEXUS_URL = 'http://nexus:8082'

        NEXUS_REGISTRY = 'nexus:8082'

        NEXUS_REPOSITORY =
            "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"

        IMAGE =
            "${NEXUS_REGISTRY}/${NEXUS_REPOSITORY}:${params.IMAGE_TAG}"

        INVENTORY =
            "ansible/inventory/${params.ENVIRONMENT}.ini"

        ANSIBLE_REQUIREMENTS =
            "ansible/requirements.yml"
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    stages {

        stage('Validate Parameters') {

            steps {

                script {

                    if (!params.IMAGE_TAG?.trim()) {
                        error(
                            "IMAGE_TAG is required. Example: omni_v2-48"
                        )
                    }

                    echo """
==========================================
DLR Sender Deployment
==========================================
Environment : ${params.ENVIRONMENT}
Image Tag   : ${params.IMAGE_TAG}
Repository  : ${env.NEXUS_REPOSITORY}
Image       : ${env.IMAGE}
Inventory   : ${env.INVENTORY}
Rollback    : ${params.ROLLBACK_ENABLED}
==========================================
"""
                }
            }
        }


        stage('Checkout') {

            steps {

                checkout scm

                sh '''
                    set -e

                    echo "Repository checkout successful."

                    echo ""
                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Ansible files:"
                    find ansible -maxdepth 5 -type f | sort
                '''
            }
        }


        stage('Validate Ansible') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Configuration"
                    echo "=========================================="

                    test -f "${INVENTORY}"
                    test -f ansible/deploy.yml
                    test -f ansible/roles/dlrsender/tasks/main.yml
                    test -f ansible/roles/dlrsender/tasks/deploy_standalone.yml
                    test -f ansible/roles/dlrsender/tasks/healthcheck.yml
                    test -f ansible/roles/dlrsender/tasks/rollback.yml

                    echo "Required files found."

                    echo ""
                    echo "Validating inventory..."

                    ansible-inventory \
                        -i "${INVENTORY}" \
                        --list > /dev/null

                    echo "Inventory validation successful."
                '''
            }
        }


        stage('Install Ansible Collections') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Installing Ansible Collections"
                    echo "=========================================="

                    if [ -f "${ANSIBLE_REQUIREMENTS}" ]; then

                        ansible-galaxy collection install \
                            -r "${ANSIBLE_REQUIREMENTS}" \
                            --force

                    else

                        echo "requirements.yml not found."

                        echo "Installing community.docker..."

                        ansible-galaxy collection install \
                            community.docker:5.2.2 \
                            --force
                    fi

                    echo ""
                    echo "Checking community.docker..."

                    ansible-doc -t module \
                        community.docker.docker_container > /dev/null

                    echo "community.docker.docker_container is available."
                '''
            }
        }


        stage('Ansible Syntax Check') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Ansible Syntax Check"
                    echo "=========================================="

                    ansible-playbook \
                        -i "${INVENTORY}" \
                        ansible/deploy.yml \
                        --syntax-check

                    echo ""
                    echo "Ansible syntax check successful."
                '''
            }
        }


        stage('Check Nexus Connectivity') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Jenkins -> Nexus"
                    echo "=========================================="

                    HTTP_STATUS=$(curl \
                        -s \
                        -o /tmp/nexus_response \
                        -w "%{http_code}" \
                        "${NEXUS_URL}/v2/")

                    echo "Nexus HTTP status: ${HTTP_STATUS}"

                    if [ "${HTTP_STATUS}" != "200" ] &&
                       [ "${HTTP_STATUS}" != "401" ]; then

                        echo "ERROR: Nexus connectivity failed."

                        cat /tmp/nexus_response || true

                        exit 1
                    fi

                    echo "Nexus connectivity successful."
                '''
            }
        }


        stage('Approval') {

            when {
                expression {
                    return params.REQUIRE_APPROVAL
                }
            }

            steps {

                script {

                    input(
                        message:
                            "Deploy DLR Sender ${params.IMAGE_TAG} to ${params.ENVIRONMENT}?",
                        ok: "Deploy"
                    )
                }
            }
        }


        stage('Verify Image in Nexus') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-creds',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Checking Docker Image in Nexus"
                        echo "=========================================="

                        echo "Repository : ${NEXUS_REPOSITORY}"
                        echo "Tag        : ${IMAGE_TAG}"
                        echo "Image      : ${IMAGE}"

                        HTTP_STATUS=$(curl \
                            -s \
                            -o /tmp/nexus_manifest.json \
                            -w "%{http_code}" \
                            -u "${NEXUS_USER}:${NEXUS_PASS}" \
                            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                            "${NEXUS_URL}/v2/${NEXUS_REPOSITORY}/manifests/${IMAGE_TAG}")

                        echo ""
                        echo "Nexus response: HTTP ${HTTP_STATUS}"

                        if [ "${HTTP_STATUS}" != "200" ]; then

                            echo "ERROR: Image does not exist in Nexus."

                            cat /tmp/nexus_manifest.json || true

                            exit 1
                        fi

                        echo ""
                        echo "SUCCESS: Image exists in Nexus."
                    '''
                }
            }
        }


        stage('Validate Docker') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Docker"
                    echo "=========================================="

                    docker version

                    echo ""
                    echo "DLR Sender containers currently running:"

                    docker ps \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}' \
                        | grep -i dlrsender || true

                    echo ""
                    echo "Docker access successful."
                '''
            }
        }


        stage('Validate Ansible Docker Access') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Docker Access"
                    echo "=========================================="

                    echo ""
                    echo "Testing Ansible connectivity..."

                    ansible \
                        -i "${INVENTORY}" \
                        all \
                        -m ansible.builtin.ping

                    echo ""
                    echo "Testing Docker access through Ansible..."

                    ansible \
                        -i "${INVENTORY}" \
                        all \
                        -m ansible.builtin.command \
                        -a "docker info"

                    echo ""
                    echo "Testing Docker containers through Ansible..."

                    ansible \
                        -i "${INVENTORY}" \
                        all \
                        -m ansible.builtin.command \
                        -a "docker ps"

                    echo ""
                    echo "Ansible Docker access successful."
                '''
            }
        }


        stage('Deploy via Ansible') {

            steps {

                script {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Deploying DLR Sender"
                        echo "=========================================="

                        echo "Environment : ${ENVIRONMENT}"
                        echo "Image       : ${IMAGE}"
                        echo "Inventory   : ${INVENTORY}"
                        echo "Rollback    : ${ROLLBACK_ENABLED}"

                        ansible-playbook \
                            -i "${INVENTORY}" \
                            ansible/deploy.yml \
                            -e "environment=${ENVIRONMENT}" \
                            -e "image_tag=${IMAGE_TAG}" \
                            -e "dlrsender_image=${IMAGE}" \
                            -e "rollback_enabled=${ROLLBACK_ENABLED}"

                        echo ""
                        echo "Ansible deployment completed."
                    '''
                }
            }
        }


        stage('Verify Deployment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Verifying DLR Sender Deployment"
                    echo "=========================================="

                    echo ""
                    echo "DLR Sender containers:"

                    docker ps \
                        --filter "name=dlrsender" \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}'

                    echo ""
                    echo "Checking expected image..."

                    RUNNING_IMAGES=$(docker ps \
                        --filter "name=dlrsender" \
                        --format '{{.Image}}')

                    echo "${RUNNING_IMAGES}"

                    if ! echo "${RUNNING_IMAGES}" | grep -q "${IMAGE}"; then

                        echo ""
                        echo "ERROR: Expected DLR Sender image is not running."

                        exit 1
                    fi

                    echo ""
                    echo "SUCCESS: DLR Sender deployment verified."
                '''
            }
        }
    }


    post {

        success {

            echo """
==========================================
DLR SENDER DEPLOYMENT SUCCESSFUL
==========================================
Environment : ${params.ENVIRONMENT}
Image Tag   : ${params.IMAGE_TAG}
Image       : ${env.IMAGE}
==========================================
"""
        }

        failure {

            echo """
==========================================
DLR SENDER DEPLOYMENT FAILED
==========================================
Environment : ${params.ENVIRONMENT}
Image Tag   : ${params.IMAGE_TAG}
Repository  : ${env.NEXUS_REPOSITORY}
Image       : ${env.IMAGE}

Check the Ansible logs for deployment/rollback details.
==========================================
"""
        }

        always {

            sh '''
                rm -f \
                    /tmp/nexus_response \
                    /tmp/nexus_manifest.json \
                    /tmp/dlrsender_15001.json \
                    /tmp/dlrsender_15002.json \
                    2>/dev/null || true
            '''
        }
    }
}