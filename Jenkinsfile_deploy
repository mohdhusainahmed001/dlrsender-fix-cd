pipeline {
    agent { label 'erlang-agent' }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Target environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Tag already pushed by the CI pipeline, e.g. release-45 or main-102'
        )

        booleanParam(
            name: 'ROLLBACK_ENABLED',
            defaultValue: true,
            description: 'Automatically roll back to the previous known-good version if health checks fail'
        )
    }

    environment {
        // Jenkins container -> Nexus container
        REGISTRY_URL = 'nexus:8082'

        // Docker host -> Nexus
        NEXUS_HOST_REGISTRY = 'localhost:8082'

        // Repository path inside Nexus
        REPO_PATH = "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"

        // Full image address used inside Jenkins
        DLRSENDER_IMAGE = "${REGISTRY_URL}/${REPO_PATH}:${params.IMAGE_TAG.trim()}"

        ANSIBLE_DIR = 'ansible'
        INVENTORY_FILE = "${ANSIBLE_DIR}/inventory/${params.ENVIRONMENT}.ini"
        PLAYBOOK = "${ANSIBLE_DIR}/deploy.yml"

        NEXUS_CREDS_ID = 'nexus-creds'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error(
                            "IMAGE_TAG is required. Example: release-45 or main-102"
                        )
                    }

                    if (!(params.IMAGE_TAG.trim() ==~ /^[a-zA-Z0-9_.\-]+$/)) {
                        error(
                            "IMAGE_TAG contains invalid characters: '${params.IMAGE_TAG}'"
                        )
                    }

                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Image Tag   : ${params.IMAGE_TAG}"
                    echo "Image       : ${env.DLRSENDER_IMAGE}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Inventory') {
            steps {
                sh """
                    set -e

                    if [ ! -f "${INVENTORY_FILE}" ]; then
                        echo "ERROR: Inventory file missing: ${INVENTORY_FILE}"
                        exit 1
                    fi

                    echo "Validating inventory: ${INVENTORY_FILE}"

                    ansible-inventory \
                        -i "${INVENTORY_FILE}" \
                        --list > /dev/null

                    echo "Inventory validation successful."
                """
            }
        }

        stage('Approval') {
            when {
                expression {
                    params.ENVIRONMENT in ['uat', 'prod']
                }
            }

            steps {
                input(
                    message: "Deploy ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}?",
                    ok: "Deploy"
                )
            }
        }

        stage('Verify Image Exists in Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''#!/bin/bash
                        set -e

                        echo "=========================================="
                        echo "Checking Docker image in Nexus"
                        echo "=========================================="
                        echo "Registry : $REGISTRY_URL"
                        echo "Repository: $REPO_PATH"
                        echo "Image Tag : $IMAGE_TAG"
                        echo "=========================================="

                        HTTP_STATUS=$(curl -s \
                            -o /tmp/nexus_check_response.json \
                            -w "%{http_code}" \
                            -u "$NEXUS_USER:$NEXUS_PASS" \
                            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                            "http://${REGISTRY_URL}/v2/${REPO_PATH}/manifests/${IMAGE_TAG}")

                        echo "Nexus responded with HTTP $HTTP_STATUS"

                        if [ -s /tmp/nexus_check_response.json ]; then
                            echo "Nexus response:"
                            cat /tmp/nexus_check_response.json
                            echo
                        fi

                        if [ "$HTTP_STATUS" != "200" ]; then
                            echo "ERROR: Image does not exist in Nexus."
                            echo "Image: $DLRSENDER_IMAGE"
                            echo "HTTP Status: $HTTP_STATUS"
                            exit 1
                        fi

                        echo "SUCCESS: Image exists in Nexus."
                        echo "Image: $DLRSENDER_IMAGE"
                    '''
                }
            }
        }

        stage('Deploy via Ansible') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh """#!/bin/bash
                        set -e

                        echo "=========================================="
                        echo "Starting Ansible deployment"
                        echo "=========================================="
                        echo "Environment : ${params.ENVIRONMENT}"
                        echo "Image       : ${NEXUS_HOST_REGISTRY}/${REPO_PATH}:${params.IMAGE_TAG.trim()}"
                        echo "Inventory   : ${INVENTORY_FILE}"
                        echo "Playbook    : ${PLAYBOOK}"
                        echo "Rollback    : ${params.ROLLBACK_ENABLED}"
                        echo "=========================================="

                        ansible-playbook \
                            -i "${INVENTORY_FILE}" \
                            "${PLAYBOOK}" \
                            --extra-vars "dlrsender_image=${NEXUS_HOST_REGISTRY}/${REPO_PATH}:${params.IMAGE_TAG.trim()} \
                                          dlrsender_registry=${NEXUS_HOST_REGISTRY} \
                                          dlrsender_registry_user=\$NEXUS_USER \
                                          dlrsender_registry_pass=\$NEXUS_PASS \
                                          target_environment=${params.ENVIRONMENT} \
                                          rollback_enabled=${params.ROLLBACK_ENABLED}"
                    """
                }
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "DEPLOYMENT SUCCESSFUL"
            echo "=========================================="
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Image       : ${env.DLRSENDER_IMAGE}"
            echo "All instances passed health checks."
        }

        failure {
            echo "=========================================="
            echo "DEPLOYMENT FAILED"
            echo "=========================================="
            echo "Environment : ${params.ENVIRONMENT}"
            echo "Image       : ${env.DLRSENDER_IMAGE}"
            echo "If ROLLBACK_ENABLED was true, check the"
            echo "'Deploy via Ansible' logs for rollback status."
        }
    }
}