pipeline {

    agent {
        label 'erlang-agent'
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Target deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag already pushed to Nexus, e.g. omni_v2-48'
        )

        booleanParam(
            name: 'ROLLBACK_ENABLED',
            defaultValue: true,
            description: 'Rollback to previous known-good image if deployment fails'
        )
    }

    environment {

        // Jenkins container -> Nexus container
        REGISTRY_URL = 'nexus:8082'

        // Docker host / Ansible target -> Nexus
        NEXUS_HOST_REGISTRY = 'localhost:8082'

        ANSIBLE_DIR = 'ansible'
        PLAYBOOK = 'ansible/deploy.yml'

        NEXUS_CREDS_ID = 'nexus-creds'
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '30'
            )
        )
    }

    stages {

        stage('Validate Parameters') {

            steps {

                script {

                    def imageTag = params.IMAGE_TAG?.trim()

                    if (!imageTag) {
                        error('IMAGE_TAG is required. Example: omni_v2-48')
                    }

                    if (!(imageTag ==~ /^[a-zA-Z0-9_.-]+$/)) {
                        error(
                            "IMAGE_TAG contains invalid characters: '${imageTag}'"
                        )
                    }

                    env.IMAGE_TAG_CLEAN = imageTag

                    env.REPO_PATH =
                        "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"

                    env.DLRSENDER_IMAGE =
                        "${env.NEXUS_HOST_REGISTRY}/${env.REPO_PATH}:${imageTag}"

                    env.DLRSENDER_JENKINS_IMAGE =
                        "${env.REGISTRY_URL}/${env.REPO_PATH}:${imageTag}"

                    env.INVENTORY_FILE =
                        "${env.ANSIBLE_DIR}/inventory/${params.ENVIRONMENT}.ini"

                    echo '=========================================='
                    echo 'DLR Sender Deployment'
                    echo '=========================================='
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Image Tag   : ${imageTag}"
                    echo "Repository  : ${env.REPO_PATH}"
                    echo "Image       : ${env.DLRSENDER_IMAGE}"
                    echo "Inventory   : ${env.INVENTORY_FILE}"
                    echo "Rollback    : ${params.ROLLBACK_ENABLED}"
                    echo '=========================================='
                }
            }
        }

        stage('Checkout') {

            steps {

                checkout scm

                sh '''
                    set -e

                    echo "Repository checkout successful."

                    echo
                    echo "Current directory:"
                    pwd

                    echo
                    echo "Ansible files:"
                    find ansible -maxdepth 5 -type f | sort
                '''
            }
        }

        stage('Validate Ansible') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Configuration"
                    echo "=========================================="

                    test -f "${INVENTORY_FILE}" || {
                        echo "ERROR: Inventory file not found:"
                        echo "${INVENTORY_FILE}"
                        exit 1
                    }

                    test -f "${PLAYBOOK}" || {
                        echo "ERROR: Playbook not found:"
                        echo "${PLAYBOOK}"
                        exit 1
                    }

                    test -f ansible/roles/dlrsender/tasks/main.yml || exit 1
                    test -f ansible/roles/dlrsender/tasks/deploy_standalone.yml || exit 1
                    test -f ansible/roles/dlrsender/tasks/healthcheck.yml || exit 1
                    test -f ansible/roles/dlrsender/tasks/rollback.yml || exit 1

                    echo "Required files found."

                    echo
                    echo "Validating inventory..."

                    ansible-inventory \
                        -i "${INVENTORY_FILE}" \
                        --list > /dev/null

                    echo "Inventory validation successful."
                '''
            }
        }

        stage('Install Ansible Collections') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Installing Ansible Collections"
                    echo "=========================================="

                    if [ -f ansible/requirements.yml ]; then

                        ansible-galaxy collection install \
                            -r ansible/requirements.yml \
                            --force

                    else

                        echo "requirements.yml not found."
                        echo "Skipping collection installation."

                    fi

                    echo
                    echo "Checking community.docker..."

                    ansible-doc \
                        -t module \
                        community.docker.docker_container > /dev/null

                    echo "community.docker.docker_container is available."
                '''
            }
        }

        stage('Ansible Syntax Check') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Ansible Syntax Check"
                    echo "=========================================="

                    ansible-playbook \
                        -i "${INVENTORY_FILE}" \
                        "${PLAYBOOK}" \
                        --syntax-check

                    echo
                    echo "Ansible syntax check successful."
                '''
            }
        }

        stage('Check Nexus Connectivity') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Jenkins -> Nexus"
                    echo "=========================================="

                    HTTP_STATUS=$(curl -s \
                        -o /tmp/nexus_response \
                        -w "%{http_code}" \
                        "http://${REGISTRY_URL}/v2/")

                    echo "Nexus HTTP status: ${HTTP_STATUS}"

                    if [ "${HTTP_STATUS}" != "200" ] && \
                       [ "${HTTP_STATUS}" != "401" ]; then

                        echo "ERROR: Jenkins cannot reach Nexus."

                        if [ -f /tmp/nexus_response ]; then
                            cat /tmp/nexus_response
                        fi

                        exit 1
                    fi

                    echo "Nexus connectivity successful."
                '''
            }
        }

        stage('Approval') {

            when {

                expression {
                    params.ENVIRONMENT in ['uat', 'prod']
                }
            }

            steps {

                input(
                    message: "Deploy ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}?",
                    ok: 'Deploy'
                )
            }
        }

        stage('Verify Image in Nexus') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Checking Docker Image in Nexus"
                        echo "=========================================="

                        echo "Repository : ${REPO_PATH}"
                        echo "Tag        : ${IMAGE_TAG_CLEAN}"
                        echo "Image      : ${DLRSENDER_JENKINS_IMAGE}"

                        HTTP_STATUS=$(curl -s \
                            -o /tmp/nexus_manifest.json \
                            -w "%{http_code}" \
                            -u "${NEXUS_USER}:${NEXUS_PASS}" \
                            -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
                            "http://${REGISTRY_URL}/v2/${REPO_PATH}/manifests/${IMAGE_TAG_CLEAN}")

                        echo
                        echo "Nexus response: HTTP ${HTTP_STATUS}"

                        if [ "${HTTP_STATUS}" != "200" ]; then

                            echo
                            echo "ERROR: Docker image does not exist in Nexus."
                            echo "Repository : ${REPO_PATH}"
                            echo "Tag        : ${IMAGE_TAG_CLEAN}"

                            if [ -s /tmp/nexus_manifest.json ]; then
                                echo
                                echo "Nexus response:"
                                cat /tmp/nexus_manifest.json
                            fi

                            exit 1
                        fi

                        echo
                        echo "SUCCESS: Image exists in Nexus."
                    '''
                }
            }
        }

        stage('Validate Docker') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Checking Docker"
                    echo "=========================================="

                    docker version

                    echo
                    echo "DLR Sender containers currently running:"

                    docker ps \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}' \
                        | grep -i dlrsender || true

                    echo
                    echo "Docker access successful."
                '''
            }
        }

        stage('Validate Ansible Docker Access') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Validating Ansible Docker Access"
                    echo "=========================================="

                    echo
                    echo "Testing Ansible connectivity..."

                    ansible \
                        -i "${INVENTORY_FILE}" \
                        all \
                        -m ping

                    echo
                    echo "Testing Docker module..."

                    ansible \
                        -i "${INVENTORY_FILE}" \
                        all \
                        -m community.docker.docker_container \
                        -a "name=dlrsender state=present"

                    echo
                    echo "Ansible Docker access successful."
                '''
            }
        }

        stage('Deploy via Ansible') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDS_ID}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "Starting DLR Sender Deployment"
                        echo "=========================================="

                        echo "Environment : ${ENVIRONMENT}"
                        echo "Image       : ${DLRSENDER_IMAGE}"
                        echo "Inventory   : ${INVENTORY_FILE}"
                        echo "Playbook    : ${PLAYBOOK}"
                        echo "Rollback    : ${ROLLBACK_ENABLED}"

                        echo
                        echo "Checking passwordless sudo..."

                        if ! sudo -n true 2>/dev/null; then

                            echo "ERROR: Jenkins agent does not have passwordless sudo."
                            echo "Ansible uses become: true."

                            exit 1
                        fi

                        echo "Passwordless sudo check successful."

                        echo
                        echo "Running Ansible deployment..."

                        ansible-playbook \
                            -i "${INVENTORY_FILE}" \
                            "${PLAYBOOK}" \
                            --extra-vars "dlrsender_image=${DLRSENDER_IMAGE}" \
                            --extra-vars "dlrsender_registry=${NEXUS_HOST_REGISTRY}" \
                            --extra-vars "dlrsender_registry_user=${NEXUS_USER}" \
                            --extra-vars "dlrsender_registry_pass=${NEXUS_PASS}" \
                            --extra-vars "target_environment=${ENVIRONMENT}" \
                            --extra-vars "rollback_enabled=${ROLLBACK_ENABLED}"

                        echo
                        echo "Ansible deployment completed successfully."
                    '''
                }
            }
        }

        stage('Verify Deployment') {

            steps {

                sh '''
                    set -e

                    echo "=========================================="
                    echo "Post Deployment Verification"
                    echo "=========================================="

                    echo
                    echo "DLR Sender containers:"

                    docker ps \
                        --format 'table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}' \
                        | grep -i dlrsender || {

                            echo "ERROR: No DLR Sender containers found."
                            exit 1
                        }

                    echo
                    echo "Checking DLR Sender health endpoints..."

                    for PORT in 15001 15002
                    do

                        echo
                        echo "Checking port ${PORT}..."

                        HTTP_STATUS=$(curl -s \
                            -o "/tmp/dlrsender_${PORT}.json" \
                            -w "%{http_code}" \
                            "http://127.0.0.1:${PORT}/metrics")

                        echo "HTTP status: ${HTTP_STATUS}"

                        if [ "${HTTP_STATUS}" != "200" ]; then

                            echo "ERROR: Health check failed on port ${PORT}"

                            if [ -s "/tmp/dlrsender_${PORT}.json" ]; then
                                cat "/tmp/dlrsender_${PORT}.json"
                            fi

                            exit 1
                        fi

                        echo "Port ${PORT}: HEALTHY"

                    done

                    echo
                    echo "Deployment verification successful."
                '''
            }
        }
    }

    post {

        success {

            echo '=========================================='
            echo 'DLR SENDER DEPLOYMENT SUCCESSFUL'
            echo '=========================================='

            echo "Environment : ${params.ENVIRONMENT}"
            echo "Image Tag   : ${params.IMAGE_TAG}"
            echo "Repository  : ${env.REPO_PATH}"
            echo "Image       : ${env.DLRSENDER_IMAGE}"
            echo "Rollback    : ${params.ROLLBACK_ENABLED}"

            echo 'All configured DLR Sender instances passed deployment and health checks.'
        }

        failure {

            echo '=========================================='
            echo 'DLR SENDER DEPLOYMENT FAILED'
            echo '=========================================='

            echo "Environment : ${params.ENVIRONMENT}"
            echo "Image Tag   : ${params.IMAGE_TAG}"
            echo "Repository  : ${env.REPO_PATH}"
            echo "Image       : ${env.DLRSENDER_IMAGE}"

            echo 'Check the Ansible logs for deployment/rollback details.'
        }

        always {

            sh '''
                rm -f /tmp/nexus_response || true
                rm -f /tmp/nexus_manifest.json || true
                rm -f /tmp/dlrsender_15001.json || true
                rm -f /tmp/dlrsender_15002.json || true
            '''
        }
    }
}