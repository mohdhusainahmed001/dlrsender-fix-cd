pipeline {
    agent { label 'erlang-agent' }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'uat', 'prod'], description: 'Target environment')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Tag already pushed by the CI pipeline, e.g. release-45 or main-102')
        booleanParam(name: 'ROLLBACK_ENABLED', defaultValue: true, description: 'Automatically roll back to the previous known-good version if health checks fail')
    }

    environment {
        REGISTRY_URL   = 'localhost:8082'   // Nexus docker registry port, published to host - same convention your CI pipeline already uses successfully
        REPO_PATH      = "onex-docker/erlang-dlrsender/${params.ENVIRONMENT}"
        DLRSENDER_IMAGE = "${REGISTRY_URL}/${REPO_PATH}:${params.IMAGE_TAG}"
        ANSIBLE_DIR    = 'ansible'
        INVENTORY_FILE = "${ANSIBLE_DIR}/inventory/${params.ENVIRONMENT}.ini"
        PLAYBOOK       = "${ANSIBLE_DIR}/deploy.yml"
        NEXUS_CREDS_ID = 'nexus-cred'   // matches the CI pipeline's credential ID
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error("IMAGE_TAG is required, e.g. the tag your CI pipeline just pushed to ${env.REGISTRY_URL}/${env.REPO_PATH}")
                    }
                    if (!(params.IMAGE_TAG ==~ /^[a-zA-Z0-9_.\-]+$/)) {
                        error("IMAGE_TAG contains invalid characters: ${params.IMAGE_TAG}")
                    }
                    echo "Deploying ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Inventory') {
            steps {
                sh """
                    test -f ${INVENTORY_FILE} || (echo 'Inventory file missing: ${INVENTORY_FILE}' && exit 1)
                    ansible-inventory -i ${INVENTORY_FILE} --list > /dev/null
                """
            }
        }

        stage('Approval') {
            when {
                expression { params.ENVIRONMENT in ['uat', 'prod'] }
            }
            steps {
                input message: "Deploy ${env.DLRSENDER_IMAGE} to ${params.ENVIRONMENT}?"
            }
        }

        stage('Verify Image Exists in Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${NEXUS_CREDS_ID}", usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh """
                        echo "\$NEXUS_PASS" | docker login ${REGISTRY_URL} -u "\$NEXUS_USER" --password-stdin
                        docker manifest inspect ${DLRSENDER_IMAGE} > /dev/null \
                            || (echo "Image ${DLRSENDER_IMAGE} not found in Nexus" && exit 1)
                    """
                }
            }
        }

        stage('Deploy via Ansible') {
            steps {
                sh """
                    ansible-playbook -i ${INVENTORY_FILE} ${PLAYBOOK} \
                        --extra-vars "dlrsender_image=${DLRSENDER_IMAGE} \
                                      target_environment=${params.ENVIRONMENT} \
                                      rollback_enabled=${params.ROLLBACK_ENABLED}"
                """
            }
        }
    }

    post {
        success {
            echo "Deployed ${DLRSENDER_IMAGE} to ${params.ENVIRONMENT} successfully. All instances passed health checks."
        }
        failure {
            echo "Deployment FAILED for ${DLRSENDER_IMAGE} on ${params.ENVIRONMENT}."
            echo "If ROLLBACK_ENABLED was true, check the 'Deploy via Ansible' log - Ansible attempts rollback automatically and reports the restored version and its health check result there."
        }
    }
}
